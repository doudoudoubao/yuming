# 安装：
#   sudo cp deploy/domain-monitor.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now domain-monitor
#   journalctl -u domain-monitor -f
[Unit]
Description=域名监控与自动抢注
Documentation=https://github.com/doudoudoubao/yuming
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=domain-monitor
Group=domain-monitor
WorkingDirectory=/opt/domain-monitor

# 密钥放这个文件里（chmod 600），不要写进 config.yaml
# 格式：TG_BOT_TOKEN=xxx  每行一个
EnvironmentFile=-/etc/domain-monitor/secrets.env
ExecStart=/opt/domain-monitor/.venv/bin/python -m domain_monitor -c /opt/domain-monitor/config.yaml run

Restart=always
RestartSec=10

# 进程死了自己没法报信，只能靠 systemd 触发。
# $SERVICE_RESULT 不是 success 时才发，正常停止不打扰。
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" = success ] || \
  /opt/domain-monitor/.venv/bin/python -m domain_monitor \
  -c /opt/domain-monitor/config.yaml notify \
  "🔴 域名监控服务异常退出（$SERVICE_RESULT / 退出码 $EXIT_STATUS），已停止监控。用 systemctl status domain-monitor 查看" || true'

# 抢注期间被 OOM 杀掉的代价很大，降低被选中的概率
OOMScoreAdjust=-500

# 沙箱化
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/domain-monitor/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
